

<MudGrid Spacing="2">
    <MudItem xs="12" sm="8">
        <MudTextField @bind-Value="Model.CompanyName"
                      Label="Company Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Required />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="Model.TINNumber"
                      Label="TIN Number" Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" @bind-Value="Model.LineOfBusiness"
                   Label="Line of Business" Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            @foreach (var item in LinesOfBusiness)
            {
                <MudSelectItem Value="@item.Name">@item.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.NatureOfBusiness"
                      Label="Nature of Business" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Required />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="string" @bind-Value="Model.IdentificationType"
                   Label="Identification Type" Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            @foreach (var item in IdentificationTypes)
            {
                <MudSelectItem Value="@item.Name">@item.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.RegistrationNumber"
                      Label="Registration Number" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Required />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudDatePicker Date="_dateOfReg" DateChanged="OnDateOfRegChanged"
                       Label="Date of Registration" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MaxDate="DateTime.Today" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudDatePicker Date="_openedOn" DateChanged="OnOpenedOnChanged"
                       Label="Opened On" Variant="Variant.Outlined"
                       Margin="Margin.Dense" MaxDate="DateTime.Today" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudSelect T="StaffMemberResponse"
                   Value="_selectedRM"
                   ValueChanged="OnRMChanged"
                   ToStringFunc="@(rm => rm is null ? "" : $"{rm.FullName} ({rm.StaffCode})")"
                   Label="Relationship Manager" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Required>
            @foreach (var rm in StaffMembers)
            {
                <MudSelectItem Value="@rm">@rm.FullName (@rm.StaffCode)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.RegisteredAt"
                      Label="Registered At" Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int?" @bind-Value="Model.BusinessStartedYear"
                         Label="Year Business Started" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="1800" Max="@DateTime.Today.Year" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int?" @bind-Value="Model.NumberOfEmployees"
                         Label="No. of Employees" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="1" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.Website"
                      Label="Website" Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentText="https://" />
    </MudItem>
    <MudItem xs="12">
        <MudTextField @bind-Value="Model.Comments"
                      Label="Comments" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Lines="2" />
    </MudItem>
</MudGrid>

@code {
    [Parameter] public ClientFormModel Model { get; set; } = default!;
    [Parameter] public List<StaffMemberResponse> StaffMembers { get; set; } = [];
    [Parameter] public List<LookupResponse> LinesOfBusiness { get; set; } = [];
    [Parameter] public List<LookupResponse> IdentificationTypes { get; set; } = [];

    private DateTime? _dateOfReg;
    private DateTime? _openedOn;
    private StaffMemberResponse? _selectedRM;

    protected override void OnParametersSet()
    {
        _dateOfReg = Model.DateOfRegistration.DateTime;
        _openedOn = Model.OpenedOn.DateTime;
        _selectedRM = StaffMembers.FirstOrDefault(s => s.Id == Model.RelationshipManagerId);
    }

    private void OnDateOfRegChanged(DateTime? d)
    {
        _dateOfReg = d;
        if (d.HasValue) Model.DateOfRegistration = new DateTimeOffset(d.Value);
    }

    private void OnOpenedOnChanged(DateTime? d)
    {
        _openedOn = d;
        if (d.HasValue) Model.OpenedOn = new DateTimeOffset(d.Value);
    }

    private void OnRMChanged(StaffMemberResponse rm)
    {
        _selectedRM = rm;
        Model.RelationshipManagerId = rm?.Id ?? Guid.Empty;
    }
}