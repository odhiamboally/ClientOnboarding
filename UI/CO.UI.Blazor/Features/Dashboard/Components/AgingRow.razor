@* One row in the aging table — label, pending bar+count, draft bar+count.
   Urgency controls bar colour: high=red, medium=amber, low=blue, normal=gray *@

<div style="display:grid; grid-template-columns:1fr 80px 80px;
    gap:8px; align-items:center; margin-bottom:10px">

    <span style="font-size:12px; color:var(--mud-palette-text-primary)">@Label</span>

    <div style="display:flex; flex-direction:column; gap:3px; align-items:center">
        <div style="width:100%; height:6px; border-radius:3px;
            background:var(--mud-palette-divider); overflow:hidden">
            <div style="height:100%; width:@(PendingWidth)%;
                background:@BarColor; border-radius:3px;
                transition:width .4s ease; min-width:@(PendingCount > 0 ? "4px" : "0")">
            </div>
        </div>
        <span style="font-size:11px; font-weight:500;
            color:@(PendingCount > 0 ? CountColor : "var(--mud-palette-text-disabled)")">
            @PendingCount
        </span>
    </div>

    <div style="display:flex; flex-direction:column; gap:3px; align-items:center">
        <div style="width:100%; height:6px; border-radius:3px;
            background:var(--mud-palette-divider); overflow:hidden">
            <div style="height:100%; width:@(DraftWidth)%;
                background:@BarColor; border-radius:3px; opacity:0.75;
                transition:width .4s ease; min-width:@(DraftCount > 0 ? "4px" : "0")">
            </div>
        </div>
        <span style="font-size:11px; font-weight:500;
            color:@(DraftCount > 0 ? CountColor : "var(--mud-palette-text-disabled)")">
            @DraftCount
        </span>
    </div>

</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public int PendingCount { get; set; }
    [Parameter, EditorRequired] public int DraftCount { get; set; }
    [Parameter] public string Urgency { get; set; } = "normal";

    // Bar widths relative to a fixed max of 30 for visual consistency
    private int PendingWidth => Math.Min((int)Math.Round(PendingCount * 100.0 / 30), 100);
    private int DraftWidth => Math.Min((int)Math.Round(DraftCount * 100.0 / 30), 100);

    private string BarColor => Urgency switch
    {
        "high" => "#E24B4A",
        "medium" => "#EF9F27",
        "low" => "#378ADD",
        _ => "#888780"
    };

    private string CountColor => Urgency switch
    {
        "high" => "#A32D2D",
        "medium" => "#854F0B",
        "low" => "#185FA5",
        _ => "var(--mud-palette-text-secondary)"
    };
}
