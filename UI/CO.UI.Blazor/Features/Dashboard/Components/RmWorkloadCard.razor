@* RmWorkloadCard.razor *@
@using MudBlazor

<div style="background:var(--mud-palette-surface);
    border:1px solid var(--mud-palette-divider);
    border-radius:10px;
    padding:20px 22px;">

    @* Header row *@
    <div style="display:flex; align-items:center;
        justify-content:space-between; margin-bottom:16px; flex-shrink:0; gap:16px">

        <p style="font-size:11px;font-weight:500;color:var(--mud-palette-text-secondary);
            text-transform:uppercase;letter-spacing:.07em;margin:0;flex-shrink:0">
            RM workload
        </p>

        @* Search *@
        <MudTextField @bind-Value="_search"
                      Immediate="true"
                      Placeholder="Search RM..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="max-width:220px;"
                      Clearable />

        @if (_overCapacityCount > 0)
        {
            <span style="font-size:11px; padding:3px 10px; border-radius:20px;
                background:#FCEBEB; color:#A32D2D; font-weight:500; flex-shrink:0">
                ⚠ @_overCapacityCount @(_overCapacityCount == 1 ? "RM" : "RMs") over capacity
            </span>
        }
    </div>

    @* Table wrapper — fixed height shows ~5 rows, scrolls for more *@
    <div style="overflow-x:auto">
        <table style="width:100%; border-collapse:collapse; font-size:13px;">

            <thead>
                <tr style="border-bottom:2px solid var(--mud-palette-divider)">
                    <th style="@ThStyle text-align:left; cursor:pointer"
                        @onclick='() => Sort("name")'>
                        RM @SortIcon("name")
                    </th>
                    <th style="@ThStyle cursor:pointer"
                        @onclick='() => Sort("total")'>
                        Clients @SortIcon("total")
                    </th>
                    <th style="@ThStyle color:#1D9E75; cursor:pointer"
                        @onclick='() => Sort("active")'>
                        Active @SortIcon("active")
                    </th>
                    <th style="@ThStyle color:#378ADD; cursor:pointer"
                        @onclick='() => Sort("pending")'>
                        Pending @SortIcon("pending")
                    </th>
                    <th style="@ThStyle color:#EF9F27; cursor:pointer"
                        @onclick='() => Sort("draft")'>
                        Draft @SortIcon("draft")
                    </th>
                    <th style="@ThStyle text-align:left; min-width:160px; cursor:pointer"
                        @onclick='() => Sort("capacity")'>
                        Capacity @SortIcon("capacity")
                    </th>
                </tr>
            </thead>

        </table>

        @* Scrollable body — 5 rows × ~52px each = ~260px *@
        <div style="max-height:200px; overflow-y:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <tbody>
                    @foreach (var rm in _filtered)
                    {
                        <tr style="border-bottom:1px solid var(--mud-palette-divider);
                            transition:background .15s"
                            onmouseover="this.style.background='var(--mud-palette-background)'"
                            onmouseout="this.style.background='transparent'">

                            <td style="padding:10px 12px; white-space:nowrap">
                                <div style="display:flex; align-items:center; gap:10px">
                                    <div style="width:30px;height:30px;border-radius:50%;flex-shrink:0;
                                        display:flex;align-items:center;justify-content:center;
                                        font-size:11px;font-weight:600;
                                        background:#e8e6fb;color:#534AB7">
                                        @rm.Initials
                                    </div>
                                    <span style="font-weight:500; color:var(--mud-palette-text-primary)">
                                        @rm.RmName
                                    </span>
                                </div>
                            </td>

                            <td style="text-align:center; padding:10px 12px; font-weight:500;
                                color:var(--mud-palette-text-primary)">
                                @rm.Total
                            </td>
                            <td style="text-align:center; padding:10px 12px;
                                font-weight:500; color:#1D9E75">
                                @rm.Active
                            </td>
                            <td style="text-align:center; padding:10px 12px;
                                font-weight:500; color:#378ADD">
                                @rm.PendingApproval
                            </td>
                            <td style="text-align:center; padding:10px 12px;
                                font-weight:500; color:#EF9F27">
                                @rm.Draft
                            </td>

                            <td style="padding:10px 12px; min-width:160px">
                                <div style="display:flex; align-items:center; gap:8px">
                                    <div style="flex:1; height:8px; border-radius:4px;
                                        background:var(--mud-palette-divider); overflow:hidden">
                                        <div style="height:100%; border-radius:4px;
                                            width:@(Math.Min(rm.CapacityPercentage, 100))%;
                                            background:@CapacityColor(rm.CapacityPercentage);
                                            transition:width .4s ease">
                                        </div>
                                    </div>
                                    <span style="font-size:12px; font-weight:500; min-width:36px;
                                        color:@CapacityColor(rm.CapacityPercentage)">
                                        @rm.CapacityPercentage%
                                    </span>
                                    @if (rm.CapacityPercentage > 100)
                                    {
                                        <span style="font-size:10px; padding:1px 6px; border-radius:10px;
                                            background:#FCEBEB; color:#A32D2D; white-space:nowrap">
                                            Over
                                        </span>
                                    }
                                </div>
                            </td>

                        </tr>
                    }

                    @if (!_filtered.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align:center; padding:24px;
                                color:var(--mud-palette-text-disabled);
                                font-size:13px">
                                No RMs match "@_search"
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<RmWorkloadRow> Items { get; set; } = default!;

    private string _search = string.Empty;
    private string _sortBy = "total";
    private bool _sortAsc = false;

    private int _overCapacityCount => Items.Count(r => r.CapacityPercentage > 100);

    private IEnumerable<RmWorkloadRow> _filtered =>
        _sorted.Where(r => string.IsNullOrWhiteSpace(_search) ||
                           r.RmName.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<RmWorkloadRow> _sorted => _sortBy switch
    {
        "name" => _sortAsc ? Items.OrderBy(r => r.RmName) : Items.OrderByDescending(r => r.RmName),
        "active" => _sortAsc ? Items.OrderBy(r => r.Active) : Items.OrderByDescending(r => r.Active),
        "pending" => _sortAsc ? Items.OrderBy(r => r.PendingApproval) : Items.OrderByDescending(r => r.PendingApproval),
        "draft" => _sortAsc ? Items.OrderBy(r => r.Draft) : Items.OrderByDescending(r => r.Draft),
        "capacity" => _sortAsc ? Items.OrderBy(r => r.CapacityPercentage) : Items.OrderByDescending(r => r.CapacityPercentage),
        _ => _sortAsc ? Items.OrderBy(r => r.Total) : Items.OrderByDescending(r => r.Total),
    };

    private void Sort(string column)
    {
        if (_sortBy == column) _sortAsc = !_sortAsc;
        else { _sortBy = column; _sortAsc = false; }
    }

    private string SortIcon(string column) =>
        _sortBy != column ? "" : _sortAsc ? "↑" : "↓";

    private static string CapacityColor(int pct) => pct switch
    {
        > 100 => "#E24B4A",
        > 80 => "#EF9F27",
        _ => "#1D9E75"
    };

    // Shared th style — avoids repeating inline styles
    private const string ThStyle =
        "text-align:center; padding:8px 12px; font-size:11px; font-weight:500; " +
        "color:var(--mud-palette-text-secondary); text-transform:uppercase; letter-spacing:.06em; ";
}
