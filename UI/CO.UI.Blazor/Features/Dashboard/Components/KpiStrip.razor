@* KpiStrip.razor *@
@* Lighter card style — white surface with coloured left accent per metric.
   Matches the reference dashboard aesthetic and integrates better with the page. *@

<div style="display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:16px;">

    <div style="background:var(--mud-palette-surface);
        border:1px solid var(--mud-palette-divider);
        border-left:4px solid #594AE2;
        border-radius:10px;
        padding:20px 22px;">
        <p style="font-size:12px;font-weight:500;color:var(--mud-palette-text-secondary);margin:0 0 6px">
            Total clients
        </p>
        <p style="font-size:34px;font-weight:500;
            color:var(--mud-palette-text-primary);line-height:1;margin:0 0 5px">
            @Total
        </p>
        <p style="font-size:12px;color:var(--mud-palette-text-disabled);margin:0">All records</p>
    </div>

    <div style="background:var(--mud-palette-surface);
        border:1px solid var(--mud-palette-divider);
        border-left:4px solid #1D9E75;
        border-radius:10px;
        padding:20px 22px;">
        <p style="font-size:12px;font-weight:500;color:var(--mud-palette-text-secondary);margin:0 0 6px">
            Active
        </p>
        <p style="font-size:34px;font-weight:500;color:#1D9E75;line-height:1;margin:0 0 5px">
            @Active
        </p>
        <p style="font-size:12px;color:var(--mud-palette-text-disabled);margin:0">
            @Pct(Active, Total)% of total
        </p>
    </div>

    <div style="background:var(--mud-palette-surface);
        border:1px solid var(--mud-palette-divider);
        border-left:4px solid #378ADD;
        border-radius:10px;
        padding:20px 22px;">
        <p style="font-size:12px;font-weight:500;color:var(--mud-palette-text-secondary);margin:0 0 6px">
            Pending approval
        </p>
        <p style="font-size:34px;font-weight:500;color:#378ADD;line-height:1;margin:0 0 5px">
            @PendingApproval
        </p>
        <p style="font-size:12px;color:var(--mud-palette-text-disabled);margin:0">Awaiting review</p>
    </div>

    <div style="background:var(--mud-palette-surface);
        border:1px solid var(--mud-palette-divider);
        border-left:4px solid #EF9F27;
        border-radius:10px;
        padding:20px 22px;">
        <p style="font-size:12px;font-weight:500;color:var(--mud-palette-text-secondary);margin:0 0 6px">
            Draft
        </p>
        <p style="font-size:34px;font-weight:500;color:#EF9F27;line-height:1;margin:0 0 5px">
            @Draft
        </p>
        <p style="font-size:12px;color:var(--mud-palette-text-disabled);margin:0">In progress</p>
    </div>

</div>

@code {
    [Parameter, EditorRequired] public int Total { get; set; }
    [Parameter, EditorRequired] public int Active { get; set; }
    [Parameter, EditorRequired] public int PendingApproval { get; set; }
    [Parameter, EditorRequired] public int Draft { get; set; }

    private static int Pct(int part, int total)
        => total == 0 ? 0 : (int)Math.Round(part * 100.0 / total);
}
